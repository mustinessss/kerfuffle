APP_NAME=Kerfuffle API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Generate a random secret of at least 32 characters for code hashing and IP throttling.
ACCESS_CODE_HASH_SECRET=

APP_PUBLIC_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required only in production; these must match the fixed ingress IPs in Compose.
PUBLIC_PROXY_IP=
PRIVATE_PROXY_IP=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Create the restricted role with ../database/app_role.sql first.
DATABASE_URL=postgresql+psycopg://kerfuffle_app:CHANGE_ME@127.0.0.1:5432/kerfuffle

# Configure SMTP for system administrator password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
