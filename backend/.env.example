APP_NAME=Kerfuffle API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Local Keycloak resource-server settings.
OIDC_ISSUER=http://localhost:8080/realms/kerfuffle
OIDC_AUDIENCE=kerfuffle-api
OIDC_JWKS_URL=http://localhost:8080/realms/kerfuffle/protocol/openid-connect/certs
OIDC_SIGNING_ALGORITHM=RS256

# Local development only. Production bootstrap uses `python -m app.cli`.
OIDC_BOOTSTRAP_ADMIN_SUBJECT=

# Generate a random secret of at least 32 characters for code hashing and IP throttling.
ACCESS_CODE_HASH_SECRET=

# Keycloak confidential service account used only by the backend to provision organizers.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=kerfuffle
KEYCLOAK_ADMIN_CLIENT_ID=kerfuffle-user-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Create the restricted role with ../database/app_role.sql first.
DATABASE_URL=postgresql+psycopg://kerfuffle_app:CHANGE_ME@127.0.0.1:5432/kerfuffle
