APP_NAME=Kerfuffle API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# OIDC resource-server settings. Use values from your identity provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_SIGNING_ALGORITHM=RS256

# Exact OIDC "sub" allowed to bootstrap the first system administrator.
# Configure before first login; existing accounts are never promoted.
OIDC_BOOTSTRAP_ADMIN_SUBJECT=

# Create the restricted role with ../database/app_role.sql first.
DATABASE_URL=postgresql+psycopg://kerfuffle_app:CHANGE_ME@127.0.0.1:5432/kerfuffle
