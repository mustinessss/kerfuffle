APP_DOMAIN=kerfuffle.example.com
ADMIN_DOMAIN=kerfuffle-admin.internal
ADMIN_BIND_IP=127.0.0.1
ADMIN_ALLOWED_CIDRS=10.66.0.0/24
APP_PUBLIC_URL=https://kerfuffle-admin.internal:8443
APP_ALLOWED_ORIGINS=https://kerfuffle.example.com,https://kerfuffle-admin.internal:8443
PUBLIC_PROXY_IP=172.29.0.2
PRIVATE_PROXY_IP=172.30.0.2

# Pin application images to sha-<commit> for reproducible deployments.
KERFUFFLE_IMAGE_TAG=latest
# Set only for rollback to an older app while retaining the schema-aware migrator.
# KERFUFFLE_MIGRATION_IMAGE_TAG=

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-character-random-hex
APP_DB_PASSWORD=replace-with-64-character-random-hex
ACCESS_CODE_HASH_SECRET=replace-with-at-least-32-random-characters

# Required to deliver system administrator password recovery links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Session lifetime (optional overrides).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
