APP_DOMAIN=kerfuffle.example.com
APP_PUBLIC_URL=https://kerfuffle.example.com
APP_ALLOWED_ORIGINS=https://kerfuffle.example.com

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-64-character-random-hex
APP_DB_PASSWORD=replace-with-64-character-random-hex
ACCESS_CODE_HASH_SECRET=replace-with-at-least-32-random-characters

# SMTP can be omitted only when MANUAL_AUTH_LINKS_ENABLED=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
MANUAL_AUTH_LINKS_ENABLED=false

# Session lifetime (optional overrides).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
